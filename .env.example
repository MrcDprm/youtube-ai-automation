# --- Pexels (https://www.pexels.com/api/ — free, 200 req/hour, 20k/month) ---
PEXELS_API_KEY=your_pexels_api_key_here

# --- Pixabay fallback (https://pixabay.com/api/docs/ — optional) ---
PIXABAY_API_KEY=

# --- YouTube Data API v3 (OAuth 2.0 Desktop App) ---
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secrets.json
YOUTUBE_TOKEN_FILE=secrets/token.json

# --- Script generation for `generate` and `daily` ---
# gemini (default) or ollama.
SCRIPT_PROVIDER=gemini

# Gemini: free key at https://aistudio.google.com/apikey
# On the free tier Google may use prompts and answers to improve its products.
GEMINI_API_KEY=
# Tried in order: when a model is busy, out of quota or retired, the next one answers.
# Free and quick in November 2026; the larger Flash models were often overloaded.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
# Checking facts with Google Search needs Gemini's paid tier for new keys. Without it the model
# writes from what it knows and is told to leave out anything it is unsure of.
GEMINI_GROUNDING=false
GEMINI_TIMEOUT=60

# Ollama, used when SCRIPT_PROVIDER=ollama (free, runs on your machine).
# Install from https://ollama.com, then: ollama pull qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=180

# --- Daily automation (optional) ---
# Produce at most one video per day via `python main.py daily` / `python main.py schedule`.
# Uploads stay off until you opt in. Privacy of generated files is still `private`.
DAILY_UPLOAD=false
DAILY_SCENES=8
DAILY_LANGUAGE=tr
DAILY_ORIENTATION=portrait
# shorts (default) or story (15–20 min landscape photo narrative). Leave shorts until
# you have reviewed a generated story scenario.
# gta makes Turkish GTA 5 Shorts from the checked facts in scenarios/topics-gta.json, over
# your own gameplay recordings in GTA_BACKGROUND_DIR.
VIDEO_FORMAT=shorts
GTA_BACKGROUND_DIR=assets/background/gta5
DAILY_TIME=09:00
SCENARIOS_DIR=scenarios
# --- Runtime ---
LOG_LEVEL=INFO
OUTPUT_DIR=output
CACHE_DIR=.cache
HTTP_TIMEOUT=30
MAX_RETRIES=4
FFMPEG_THREADS=4
DEFAULT_FONT=assets/fonts/Inter-Bold.ttf
