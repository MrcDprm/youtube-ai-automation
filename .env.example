# --- Pexels (https://www.pexels.com/api/ — free, 200 req/hour, 20k/month) ---
PEXELS_API_KEY=your_pexels_api_key_here

# --- Pixabay fallback (https://pixabay.com/api/docs/ — optional) ---
PIXABAY_API_KEY=

# --- YouTube Data API v3 (OAuth 2.0 Desktop App) ---
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secrets.json
YOUTUBE_TOKEN_FILE=secrets/token.json

# --- Runtime ---
LOG_LEVEL=INFO
OUTPUT_DIR=output
CACHE_DIR=.cache
HTTP_TIMEOUT=30
MAX_RETRIES=4
FFMPEG_THREADS=4
DEFAULT_FONT=assets/fonts/Inter-Bold.ttf
